# ==============================================================================
# Variables de entorno SOLO para el servidor (Vercel / entorno local no versionado)
# NUNCA commitear .env ni .env.local en Git ni incluir estas claves en la app móvil.
# ==============================================================================

# Cuenta de servicio de Firebase Admin SDK
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase.iam.gserviceaccount.com
# En Vercel pega la clave privada con saltos de línea literales (\n); la API los convierte automáticamente.
FIREBASE_PRIVATE_KEY="REEMPLAZAR_CON_TU_CLAVE_PRIVADA_PEM_EN_VERCEL_CON_SALTOS_ESCAPADOS"

# Clave Web de Firebase (usada SOLO desde la API para llamar a Firebase Auth REST API)
FIREBASE_WEB_API_KEY=REEMPLAZAR_CON_FIREBASE_WEB_API_KEY_EN_VERCEL

# Límite de tasa en /api/auth/login (opcional)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
